# Public URL shown in links and generated setup records
API_BASE_URL=http://localhost:3024

# Docker Compose database
POSTGRES_DB=mailhub
POSTGRES_USER=mailhub
POSTGRES_PASSWORD=CHANGE_ME_postgres_password

# Direct Postgres connection used by non-Docker installs
DATABASE_URL=postgresql://mailhub:CHANGE_ME_postgres_password@127.0.0.1:5432/mailhub

# Raw email storage
RAW_DIR=/opt/mailhub/raw
LOG_DIR=/opt/mailhub/logs
MAILHUB_UPLOAD_DIR=/opt/mailhub/uploads/outbound
MAILHUB_OUTBOUND_DIR=/opt/mailhub/raw/outbound

# JWT
JWT_SECRET=CHANGE_ME_random_hex_48bytes
JWT_COOKIE_NAME=mailhub_session
COOKIE_SECURE=false

# First boot seed. Leave MAILHUB_ADMIN_PASSWORD empty if you prefer /setup.
MAILHUB_ADMIN_USERNAME=admin
MAILHUB_ADMIN_PASSWORD=
MAILHUB_ADMIN_EMAIL=admin@example.com
MAILHUB_ADMIN_DISPLAY_NAME=Administrator
MAILHUB_APP_NAME=Mailhub
MAILHUB_DOMAIN=example.com
MAILHUB_INBOUND_HOST=mail.example.com

# Published ports
MAILHUB_WEB_BIND=0.0.0.0
MAILHUB_WEB_PORT=3024
MAILHUB_API_BIND=127.0.0.1
MAILHUB_API_PORT=8024

# IMAP polling worker
IMAP_SYNC_INTERVAL_SECONDS=300
MAILHUB_IMAP_SYNC_LIMIT=50
